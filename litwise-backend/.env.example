# ===== SUPABASE CONFIGURATION =====
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ===== REDIS/UPSTASH CACHE CONFIGURATION =====
REDIS_URL=rediss://default:password@endpoint:6379
UPSTASH_REDIS_REST_URL=https://your-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# ===== QDRANT VECTOR DATABASE CONFIGURATION =====
QDRANT_URL=https://your-instance.aws.cloud.qdrant.io
QDRANT_API_KEY=your-api-key

# ===== LLM API KEYS =====
OPENAI_API_KEY=sk-...
XAI_API_KEY=xai-...

# ===== LANGSMITH TRACING (Optional) =====
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_PROJECT=litwise-project

# ===== ERROR MONITORING (Sentry) =====
# Essential for production error tracking
# Get from: https://sentry.io (free account)
SENTRY_DSN=https://your-key@sentry.io/project-id
ENVIRONMENT=development

# ===== CORS CONFIGURATION =====
# For development: Leave ALLOWED_ORIGINS unset (defaults to localhost:3000)
# For production: Set ALLOWED_ORIGINS to your domain(s), comma-separated
# Example production: ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=

# ===== RATE LIMITING =====
RATE_LIMIT_ENABLED=true
